      "Bash(php artisan make:middleware:*)",
      "Bash(php artisan make:controller:*)",
      "Bash(php artisan make:model:*)",
      "Bash(php artisan make:listener:*)",
      "Bash(find:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(php -l:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(php artisan config:clear:*)",
      "Bash(php artisan view:clear:*)",
      "Bash(php artisan make:migration:*)",
